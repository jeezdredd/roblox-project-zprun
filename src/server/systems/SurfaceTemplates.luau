--!strict

-- SurfaceAppearance templates for meshes loaded from Model assets
-- (ReplicatedStorage.ViewmodelSurfaces and .ZombieSurfaces, generated by
-- scripts/sync_configs.py from the texture/viewmodel/ and texture/zombie/ manifest rows).
-- A mesh the importer left without a SurfaceAppearance gets the template named for the
-- material in its name; with `replace` the template also takes the place of the
-- importer's own, which Roblox builds from a metallicRoughness texture without the
-- material's metallicFactor (a skin over a white B channel at factor 0 comes in as metal).

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local SurfaceTemplates = {}

-- `surfaces` maps a material name found in the mesh's name to a template name; the
-- longest match wins ("Hand_Mesh_Glove_D_0" is Glove_D). True when a template went on.
function SurfaceTemplates.dress(part: MeshPart, folderName: string, surfaces: { [string]: string }?, replace: boolean?): boolean
	local existing = part:FindFirstChildOfClass("SurfaceAppearance")
	if not surfaces or (existing and not replace) then
		return false
	end
	local best: string? = nil
	for material in surfaces do
		if string.find(part.Name, material, 1, true) and (not best or #material > #best) then
			best = material
		end
	end
	local folder = ReplicatedStorage:FindFirstChild(folderName)
	local template = if best and folder then folder:FindFirstChild(surfaces[best]) else nil
	if not (template and template:IsA("SurfaceAppearance")) then
		return false
	end
	if existing then
		existing:Destroy()
	end
	template:Clone().Parent = part
	return true
end

-- Every MeshPart under `root`; returns how many took a template.
function SurfaceTemplates.dressAll(root: Instance, folderName: string, surfaces: { [string]: string }?, replace: boolean?): number
	if not surfaces then
		return 0
	end
	local count = 0
	for _, item in root:GetDescendants() do
		if item:IsA("MeshPart") and SurfaceTemplates.dress(item, folderName, surfaces, replace) then
			count += 1
		end
	end
	return count
end

return SurfaceTemplates
